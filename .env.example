# ─── CIVIC — Variables de entorno ───────────────────────────────────────────
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el archivo .env al repositorio.

# Google Gemini IA
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Base de datos
DATABASE_URL=sqlite:///./civic.db

# JWT
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# CORS
ALLOWED_ORIGINS=http://localhost:5500

# Almacenamiento de imágenes
UPLOAD_DIR=./uploads

# Nominatim (geocodificación inversa)
NOMINATIM_USER_AGENT=civic/1.0 (contacto@ejemplo.com)
